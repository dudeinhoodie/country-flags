<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What this app collects and which restricted APIs it calls, declared for the
  App Store.

  It is written from what the code actually does rather than from what an app
  like this usually does, and every entry below can be traced to a call site.
  The two consent-gated categories — product analytics and diagnostics — are
  declared because the app is capable of sending them, not because it does by
  default: both start off and nothing is sent until somebody turns them on
  (PrivacyStore, the consent filter in the analytics queue, and the backend,
  which refuses product events without a stored GRANTED). What is sent
  without asking is declared too: the review history of a signed-in learner,
  and the operational reports on syncs and content updates.

  Nothing here is used for tracking. There is no advertising identifier, no ad
  SDK and no tracking prompt in the app, which Scripts/check-advertising-policy.sh
  enforces on every build.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
		  The address behind Sign in with Apple or Google. The app never reads
		  it: it forwards the provider's identity token, and the backend stores
		  the address it contains so an account can be recovered and its logins
		  told apart. Declared because the service collects it through this app.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  The account identifier, and the installation identifier a guest is
		  scoped by. Both travel with answers so progress lands under the right
		  learner, and with analytics events as a pseudonymous key.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>

		<!--
		  How the learner uses the app, for two purposes.

		  App functionality: the review history. Every answer of a signed-in
		  learner (which card, the rating, when, how long it took) is uploaded
		  so the schedule and the progress live on the account and survive a
		  new phone, and a guest's history is uploaded once, when it is carried
		  into the account at sign-in. No switch turns this off: it is the
		  service the account exists for.

		  Analytics: which screens were opened and how sessions went. Sent only
		  while product analytics is switched on, and it never carries an
		  answer, an address or a token: the registry types every event and
		  the redaction denylist drops anything else.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>

		<!--
		  Operational reports, sent without asking, guests included: whether a
		  sync or a content update succeeded, and a duration bucket for a
		  sync (`sync.completed`, `content.update_completed` in the analytics
		  registry, category essential_operations). They travel with the
		  pseudonymous analytics identifier, the app version, build, platform
		  and language, and with the account when one is signed in. They are
		  how a broken sync becomes visible, and nothing about a person is in
		  them.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Crash reports, sent only while diagnostics is switched on. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Launch times and hangs from MetricKit, on the same switch. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
		  UserDefaults, for this app's own settings: the content manifest tag,
		  whether a guest's progress has been migrated, and the notice left
		  behind by an account deletion. Nothing is read from another app or
		  another vendor, which is what CA92.1 declares.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
