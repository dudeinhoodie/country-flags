    "account.deletion_pending.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything will be gone by %@. Until then you can keep studying as a guest."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё сотрём до %@. До тех пор можно тренироваться как гость."
