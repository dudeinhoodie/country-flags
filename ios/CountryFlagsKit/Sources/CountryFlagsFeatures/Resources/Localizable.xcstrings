    "account.guest_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in keeps your progress if this device is lost."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход сохранит прогресс, даже если это устройство потеряется."
          }
        }
      }
    },
    "account.identities_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding a second way in means you can still reach this account if you lose access to the first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Второй способ входа — это возможность попасть в аккаунт, если доступ к первому потерян."
          }
        }
      }
    },
    "account.identities_section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ways to sign in"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Способы входа"
          }
        }
      }
    },
    "account.identity_duplicate.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account already has a login from that provider."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У аккаунта уже есть вход через этого провайдера."
          }
        }
      }
    },
    "account.identity_failed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That did not work"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не получилось"
          }
        }
      }
    },
    "account.identity_last.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the only way into the account, so it cannot be removed. Add another one first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это единственный способ войти в аккаунт, поэтому удалить его нельзя. Сначала добавьте другой."
          }
        }
      }
    },
    "account.identity_last_used": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last used %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последний вход %@"
          }
        }
      }
    },
    "account.identity_offline.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device is offline. Try again when it is back."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сети. Попробуйте, когда связь вернётся."
          }
        }
      }
    },
    "account.identity_refused.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change was refused. Try again later."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение отклонено. Попробуйте позже."
          }
        }
      }
    },
    "account.identity_taken.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out and sign in with it to use that account. Two accounts cannot be joined."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйдите и войдите через него, чтобы пользоваться тем аккаунтом. Объединить два аккаунта нельзя."
          }
        }
      }
    },
    "account.identity_taken.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This login belongs to another account"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот вход принадлежит другому аккаунту"
          }
        }
      }
    },
