    "account.delete.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your progress, awards, settings and every way in are gone. The app stays — you just start from nothing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс, награды, настройки и все способы входа исчезнут. Приложение останется — просто начнёшь с нуля."
          }
        }
      }
    },
    "account.delete.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить"
          }
        }
      }
    },
    "account.delete.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account is still here — nothing was deleted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт на месте — ничего не удалили."
          }
        }
      }
    },
