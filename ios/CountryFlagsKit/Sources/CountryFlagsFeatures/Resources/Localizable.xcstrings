    "account.danger_section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting the account"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление аккаунта"
          }
        }
      }
    },
    "account.delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить аккаунт"
          }
        }
      }
