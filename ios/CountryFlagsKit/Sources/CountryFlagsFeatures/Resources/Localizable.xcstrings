    "privacy.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both are off until you turn them on, and neither changes how the app works. Analytics counts screens, sessions and outcomes — never your answers, your email or your sign-in. Diagnostics sends crash reports. Turn one off and whatever has not been sent is deleted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба выключены, пока не включишь, и на работу приложения не влияют. Аналитика считает экраны, тренировки и результаты — но не ответы, почту и данные входа. Диагностика шлёт отчёты о сбоях. Выключишь — то, что не успело уйти, удалится."
          }
        }
      }
    },
