          "stringUnit": {
            "state": "translated",
            "value": "Архив подготовить не удалось. Запросите его ещё раз."
          }
        }
      }
    },
    "account.export_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive is prepared on the server and the link it comes back with is short-lived."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив готовится на сервере, а ссылка на него живёт недолго."
