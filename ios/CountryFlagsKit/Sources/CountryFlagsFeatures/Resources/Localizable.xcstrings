    "privacy.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both are off until you turn them on. Analytics counts screens and sessions — not your answers, your email or your sign-in. Diagnostics sends crash reports. Turn one off and anything unsent is deleted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба выключены, пока не включишь. Аналитика считает экраны и тренировки — не ответы, почту и данные входа. Диагностика шлёт отчёты о сбоях. Выключишь — неотправленное удалится."
          }
        }
      }
    },
