{
  "sourceLanguage": "en",
  "strings": {
    "account.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "account.danger_section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting the account"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление аккаунта"
          }
        }
      }
    },
    "account.delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить аккаунт"
          }
        }
      }
    },
    "account.delete.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your progress, achievements, settings and every way of signing in are deleted. The app keeps working without an account, starting from nothing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс, достижения, настройки и все способы входа будут удалены. Приложение продолжит работать без аккаунта — с нуля."
          }
        }
      }
    },
    "account.delete.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить аккаунт"
          }
        }
      }
    },
    "account.delete.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account was not deleted, so nothing was removed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт не удалён, поэтому ничего не потеряно."
          }
        }
      }
    },
    "account.delete.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this account?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить этот аккаунт?"
          }
        }
      }
    },
    "account.delete.working": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляем…"
          }
        }
      }
    },
    "account.deletion_pending.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is expected to be gone by %@. You can keep studying as a guest."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидаемая дата завершения — %@. Заниматься можно как гость."
          }
        }
      }
    },
    "account.deletion_pending.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is being deleted"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт удаляется"
          }
        }
      }
    },
    "account.device_details": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ · seen %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия %1$@ · был %2$@"
          }
        }
      }
    },
    "account.devices_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoking a device signs it out. Revoking this one signs you out here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отзыв устройства завершает его сессии. Отзыв этого — выход на нём."
          }
        }
      }
    },
    "account.devices_section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства"
          }
        }
      }
    },
    "account.expired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session expired. Sign in again to continue syncing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия истекла. Войдите снова, чтобы продолжить синхронизацию."
          }
        }
      }
    },
    "account.export_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
