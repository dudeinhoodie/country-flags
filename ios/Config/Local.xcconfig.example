// Copy to ios/Config/Local.xcconfig and fill in for your machine.
// The file is not committed: it holds developer identifiers and local paths.
//
//   cp ios/Config/Local.xcconfig.example ios/Config/Local.xcconfig
//
// No key here is an application secret. Tokens, provider keys and signing
// identities never enter the repository in any form.

// The Apple Developer Team ID for running on a device locally.
// Simulator and CI builds are unsigned and do not need it.
// A free Apple ID works: add it in Xcode Settings -> Accounts, pick the
// "(Personal Team)" once in Signing & Capabilities, copy the team id Xcode
// resolves (Build Settings -> DEVELOPMENT_TEAM), put it here and discard the
// project-file change. Free profiles expire after 7 days; rerun from Xcode.
CF_DEVELOPMENT_TEAM =

// A unique bundle id suffix so several developers do not fight over one
// identifier when installing on a device.
// CF_BUNDLE_ID_SUFFIX = .dev.yourname

// Empty the entitlements file so a device build works on a free Apple team.
//
// A personal team does not support Sign in with Apple, and a build that asks
// for the capability cannot be signed at all — Xcode refuses before it
// compiles. Emptying this is how you get the app onto a phone in the
// meantime, and what it costs is exactly one thing: Sign in with Apple does
// not work in that build. Google still does in Dev.
//
// Leave it alone on a paid team. It is not a preference.
// CF_APP_ENTITLEMENTS = none

// A local backend instead of the dev deployment.
// The `/$()/` escape is required: a bare `//` starts an xcconfig comment.
// CF_API_BASE_URL = http:/$()/localhost:3000
