// Скопируйте в ios/Config/Local.xcconfig и заполните под своё окружение.
// Файл не коммитится: он содержит идентификаторы разработчика и локальные пути.
//
//   cp ios/Config/Local.xcconfig.example ios/Config/Local.xcconfig
//
// Ни один ключ здесь не является секретом приложения. Токены, ключи провайдеров
// и signing identity в репозиторий не попадают ни в каком виде.

// Apple Developer Team ID для локального запуска на устройстве.
// Сборка на симуляторе и в CI идёт без подписи и этот ключ не требует.
CF_DEVELOPMENT_TEAM =

// Уникальный суффикс bundle ID, чтобы несколько разработчиков не конфликтовали
// за один идентификатор при установке на устройство.
// CF_BUNDLE_ID_SUFFIX = .dev.yourname

// Локальный backend вместо dev-развёртывания.
// Экранирование `/$()/` обязательно: иначе `//` считается комментарием xcconfig.
// CF_API_BASE_URL = http:/$()/localhost:3000
