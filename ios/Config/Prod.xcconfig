// Релизная конфигурация: без mock-транспорта и отладочных аффордансов.
#include "Base.xcconfig"

CF_APP_ENVIRONMENT = prod
CF_API_BASE_URL = https:/$()/api.country-flags.app
CF_BUNDLE_ID_SUFFIX =
PRODUCT_NAME = CountryFlags

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited)
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
GCC_OPTIMIZATION_LEVEL = s
ONLY_ACTIVE_ARCH = NO
ENABLE_TESTABILITY = NO
VALIDATE_PRODUCT = YES
