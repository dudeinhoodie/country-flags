// The release configuration: no mock transport and no debug affordances.
#include "Base.xcconfig"

CF_APP_ENVIRONMENT = prod
// The production API on Cloud Run. Release 1.0 has no domain, so this is the
// service's deterministic run.app address, which `api-prod` answers on from
// its first deploy. The `$()` breaks the `//` so xcconfig does not read the
// rest of the line as a comment.
CF_API_BASE_URL = https:/$()/api-prod-6vgdmsupva-ey.a.run.app
CF_BUNDLE_ID_SUFFIX =
PRODUCT_NAME = Vexi

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited)
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
GCC_OPTIMIZATION_LEVEL = s
ONLY_ACTIVE_ARCH = NO
ENABLE_TESTABILITY = NO
VALIDATE_PRODUCT = YES
