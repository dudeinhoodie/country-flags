// The build that talks to the dev backend environment.
#include "Base.xcconfig"

CF_APP_ENVIRONMENT = dev
// The public address of the dev deployment. It holds no secret and is
// overridden in Local.xcconfig when working against a local backend.
// The Cloud Run service, until a domain is pointed at it. The `$()` breaks the
// `//` so xcconfig does not read the rest of the line as a comment.
CF_API_BASE_URL = https:/$()/api-dev-337239833704.europe-west3.run.app
CF_BUNDLE_ID_SUFFIX = .dev

// The dev Google OAuth clients. Public identifiers, not secrets: the iOS one
// names this app to Google, the server one is the audience the backend
// verifies, and the scheme is the iOS identifier reversed -- the road back
// from the browser.
CF_GOOGLE_IOS_CLIENT_ID = 337239833704-dqjk6p29992umu146vv490bissllho5f.apps.googleusercontent.com
CF_GOOGLE_SERVER_CLIENT_ID = 337239833704-r2eed1a28ggnmri1md2hqp2hgm11236h.apps.googleusercontent.com
CF_GOOGLE_URL_SCHEME = com.googleusercontent.apps.337239833704-dqjk6p29992umu146vv490bissllho5f
PRODUCT_NAME = CountryFlags Dev

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
GCC_OPTIMIZATION_LEVEL = 0
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
