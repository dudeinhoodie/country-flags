// Сборка против dev-окружения backend.
#include "Base.xcconfig"

CF_APP_ENVIRONMENT = dev
// Публичный адрес dev-развёртывания; секретов не содержит и переопределяется
// в Local.xcconfig при работе против локального backend.
CF_API_BASE_URL = https:/$()/dev.api.country-flags.app
CF_BUNDLE_ID_SUFFIX = .dev
PRODUCT_NAME = CountryFlags Dev

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
GCC_OPTIMIZATION_LEVEL = 0
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
