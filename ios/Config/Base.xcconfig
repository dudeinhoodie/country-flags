// Settings shared by every configuration. Values that differ per environment
// live in Mock/Dev/Prod.xcconfig.

// Developer specific overrides (DEVELOPMENT_TEAM, bundle id suffix) live in an
// uncommitted Local.xcconfig; see Local.xcconfig.example.
#include? "Local.xcconfig"

PRODUCT_NAME = CountryFlags
CF_BUNDLE_ID_BASE = app.countryflags.mobile

// Google OAuth clients. Empty until the console credentials exist for the
// configuration; an empty value hides the Google button. The scheme is the
// iOS client identifier with its dot-order reversed, which is how Google's
// browser round trip finds its way back into the app. None of these is a
// secret.
CF_GOOGLE_IOS_CLIENT_ID =
CF_GOOGLE_SERVER_CLIENT_ID =
CF_GOOGLE_URL_SCHEME = 
PRODUCT_BUNDLE_IDENTIFIER = $(CF_BUNDLE_ID_BASE)$(CF_BUNDLE_ID_SUFFIX)

// iOS 26: the first release whose material system draws the glass this
// design is built on. Raising the floor is ADR-012's decision — the app has
// not shipped, so the floor costs nobody an update.
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphonesimulator iphoneos
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
ENABLE_MODULE_VERIFIER = NO
DEVELOPMENT_LANGUAGE = en

// Test bundles are happy with a generated Info.plist. The app target overrides
// this and points INFOPLIST_FILE at Config/App-Info.plist, because a generated
// plist drops application specific keys.
GENERATE_INFOPLIST_FILE = YES

// CI verifies the build without any developer account.
CODE_SIGN_STYLE = Automatic
CODE_SIGNING_REQUIRED = NO
CODE_SIGNING_ALLOWED = NO
// The simulator is ad-hoc signed: with signing disabled outright the binary
// carries no entitlements, the keychain answers -34018 to every call, the
// guest identity is reborn on each launch and Google's SDK dies saving its
// session. Ad-hoc needs no certificate, so CI is unaffected.
CODE_SIGNING_ALLOWED[sdk=iphonesimulator*] = YES
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -
DEVELOPMENT_TEAM = $(CF_DEVELOPMENT_TEAM)

// Config/App-Info.plist substitutes these into the app bundle, where
// RuntimeConfigurationLoader reads them. None of them is a secret.
CF_DEEP_LINK_SCHEME = countryflags
