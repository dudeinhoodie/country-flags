{
  "name": "@country-flags/content-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "yarn workspace @country-flags/asset-core build && tsc --project tsconfig.build.json",
    "content": "yarn build && node dist/src/cli.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,mjs}\" \"editorial/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,mjs}\" \"editorial/**/*.json\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "yarn build && node --test \"dist/test/**/*.spec.js\""
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/node": "22.17.0",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0"
  },
  "dependencies": {
    "@country-flags/asset-core": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
