# Substituted by the stock nginx entrypoint. Only ${PORT} and
# ${ADMIN_API_UPSTREAM} are environment variables; $uri and friends are
# nginx runtime variables and survive envsubst untouched.
server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;

  # The runtime config must never be cached: it is what tells the SPA which
  # environment it is talking to.
  location = /config.json {
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
  }

  # Same-origin proxy to the backend keeps cookies host-only and the image
  # identical across environments. ADMIN_API_UPSTREAM is the backend origin
  # without a trailing slash; the /api/ prefix is stripped, so
  # /api/v1/admin/me reaches the backend as /v1/admin/me.
  location /api/ {
    proxy_pass ${ADMIN_API_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Vite emits content-hashed filenames under /assets, safe to cache forever.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    try_files $uri /index.html;
  }
}
