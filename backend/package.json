{
  "name": "@country-flags/backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "yarn workspace @country-flags/asset-core build && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,mjs}\" && prisma format",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,mjs}\" && prisma format --check",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "yarn workspace @country-flags/asset-core build && NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:unit": "yarn workspace @country-flags/asset-core build && NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathIgnorePatterns=e2e-spec",
    "test:e2e": "yarn workspace @country-flags/asset-core build && NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPattern=e2e-spec",
    "test:migrations": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPattern=migrations.e2e-spec",
    "test:ci": "yarn workspace @country-flags/asset-core build && NODE_OPTIONS=--experimental-vm-modules jest --ci --runInBand --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "content:import:test": "ts-node src/cli/import-test-content.ts",
    "study:seed:test": "ts-node src/cli/import-test-study-seed.ts",
    "study:token:test": "ts-node src/cli/print-test-access-token.ts",
    "auth:provider-token:test": "ts-node src/cli/print-test-provider-token.ts",
    "content:bundle:validate": "ts-node src/cli/content-bundle-validate.ts",
    "content:bundle:preview": "ts-node src/cli/content-bundle-preview.ts",
    "content:bundle:publish": "ts-node src/cli/content-bundle-publish.ts",
    "content:bundle:rollback": "ts-node src/cli/content-bundle-rollback.ts",
    "content:bundle:sign": "ts-node src/cli/content-bundle-sign.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1115.0",
    "@country-flags/asset-core": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@prisma/client": "6.13.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv": "17.4.2",
    "helmet": "^8.3.0",
    "jose": "6.2.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ts-fsrs": "5.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.6",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/multer": "2.2.0",
    "@types/node": "22.17.0",
    "@types/supertest": "7.2.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "prisma": "6.13.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.67.0",
    "yaml": "2.9.0"
  }
}
