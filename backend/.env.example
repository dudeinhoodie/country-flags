NODE_ENV=development
# Deployment environment: local | ci | dev | prod. NODE_ENV describes Node.js
# runtime semantics; DEPLOYMENT_ENV selects environment-specific resources,
# telemetry labels, OAuth clients and data policy. dev and prod both require
# NODE_ENV=production, and NODE_ENV=production requires this to be set
# explicitly — there is no safe default between dev and prod.
DEPLOYMENT_ENV=local
PORT=3000
LOG_LEVEL=info
# Runtime connection. Hosted environments point this at the pooled endpoint.
DATABASE_URL=postgresql://country_flags:country_flags@localhost:5432/country_flags?schema=public
# Direct (non-pooled) connection used by Prisma migrations. Required in dev/prod;
# defaults to DATABASE_URL elsewhere, where both reach the same database.
DIRECT_DATABASE_URL=postgresql://country_flags:country_flags@localhost:5432/country_flags?schema=public
TEST_AUTH_ENABLED=true
AUTH_PROVIDER_TEST_TOKENS_ENABLED=true
# The TEST_ONLY defaults are supplied automatically outside production.
# Production must provide unique secrets (at least 32 characters) and real client IDs.
# AUTH_PROVIDER_TEST_SECRET=
# AUTH_ACCESS_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_ISSUER=country-flags-local
AUTH_ACCESS_TOKEN_AUDIENCE=country-flags-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REAUTH_TOKEN_TTL_SECONDS=300
# AUTH_RATE_LIMIT_SECRET=
# ACCOUNT_DATA_HASH_SECRET=
DATA_EXPORT_DOWNLOAD_TTL_SECONDS=300
PUBLIC_BASE_URL=http://localhost:3000
APPLE_CLIENT_IDS=com.countryflags.local
GOOGLE_CLIENT_IDS=country-flags-local.apps.googleusercontent.com
# Allowlist for the (currently unbuilt) web client. Never "*". Empty by default in
# production, meaning no cross-origin browser access until a web client origin is added.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Grace period between marking readiness as failing and closing the HTTP server on
# SIGTERM/SIGINT, so a load balancer has time to stop routing before the process exits.
SHUTDOWN_DRAIN_MS=5000
# Content bundle pipeline (CLI-only; the running API does not read these).
# OBJECT_STORAGE_PROVIDER=memory selects a network-free in-process store, useful for tests.
# Set to "s3" plus the vars below to target local MinIO (see infrastructure/compose.yaml) or
# a production S3-compatible bucket.
OBJECT_STORAGE_PROVIDER=memory
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# The public root of the bucket, without a trailing slash. A publish stores a release
# under content/<contentVersion>/<path> and hands clients that key behind this address,
# so it is what every asset URL of a release published here is built on. In production
# it is the CDN in front of the bucket, which keeps those URLs what they have always been.
# OBJECT_STORAGE_PUBLIC_BASE_URL=
# Generated bundles ship UNSIGNED (signature keyId "unsigned-candidate"). Before publishing,
# sign the bundle locally: `yarn content:bundle:sign -- --bundle-dir <dir>`; validate/publish
# then verify the signature. Do not commit a signed manifest — `content build` owns the
# generated output and will revert it.
# CONTENT_SIGNING_KEY_ID and CONTENT_SIGNING_PRIVATE_KEY (base64 PKCS8 PEM) are required by
# `content:bundle:sign`. CONTENT_SIGNING_PUBLIC_KEYS (base64 JSON map of keyId -> PEM SPKI
# public key) is required by `content:bundle:validate`/`publish` to verify a signed bundle.
# CONTENT_SIGNING_KEY_ID=
# CONTENT_SIGNING_PRIVATE_KEY=
# CONTENT_SIGNING_PUBLIC_KEYS=
# OpenTelemetry traces/metrics are read directly from process.env before the Nest app
# bootstraps (so they can be set before anything under instrumentation loads), not through
# the validated EnvironmentVariables. @opentelemetry/api's own tracer/meter are already
# no-ops when OTEL_ENABLED is unset, which is the required "NoOp by default" behavior.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SERVICE_NAME=country-flags-api
# Identifies the deployed release in logs, traces and metrics. Hosted dev/prod
# must set the release image tag / git SHA; the "dev" placeholder is rejected there.
SERVICE_RELEASE=dev
