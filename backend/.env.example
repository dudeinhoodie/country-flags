NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://country_flags:country_flags@localhost:5432/country_flags?schema=public
TEST_AUTH_ENABLED=true
AUTH_PROVIDER_TEST_TOKENS_ENABLED=true
# The TEST_ONLY defaults are supplied automatically outside production.
# Production must provide unique secrets (at least 32 characters) and real client IDs.
# AUTH_PROVIDER_TEST_SECRET=
# AUTH_ACCESS_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_ISSUER=country-flags-local
AUTH_ACCESS_TOKEN_AUDIENCE=country-flags-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# AUTH_RATE_LIMIT_SECRET=
APPLE_CLIENT_IDS=com.countryflags.local
GOOGLE_CLIENT_IDS=country-flags-local.apps.googleusercontent.com
