NODE_ENV=development
# Deployment environment: local | ci | dev | prod. NODE_ENV describes Node.js
# runtime semantics; DEPLOYMENT_ENV selects environment-specific resources,
# telemetry labels, OAuth clients and data policy. dev and prod both require
# NODE_ENV=production, and NODE_ENV=production requires this to be set
# explicitly — there is no safe default between dev and prod.
DEPLOYMENT_ENV=local
PORT=3000
LOG_LEVEL=info
# Runtime connection. Hosted environments point this at the pooled endpoint.
DATABASE_URL=postgresql://country_flags:country_flags@localhost:5432/country_flags?schema=public
# Direct (non-pooled) connection used by Prisma migrations. Required in dev/prod;
# defaults to DATABASE_URL elsewhere, where both reach the same database.
DIRECT_DATABASE_URL=postgresql://country_flags:country_flags@localhost:5432/country_flags?schema=public
TEST_AUTH_ENABLED=true
AUTH_PROVIDER_TEST_TOKENS_ENABLED=true
# The TEST_ONLY defaults are supplied automatically outside production.
# Production must provide unique secrets (at least 32 characters) and real client IDs.
# AUTH_PROVIDER_TEST_SECRET=
# AUTH_ACCESS_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_ISSUER=country-flags-local
AUTH_ACCESS_TOKEN_AUDIENCE=country-flags-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REAUTH_TOKEN_TTL_SECONDS=300
# AUTH_RATE_LIMIT_SECRET=
# ACCOUNT_DATA_HASH_SECRET=
DATA_EXPORT_DOWNLOAD_TTL_SECONDS=300
PUBLIC_BASE_URL=http://localhost:3000
APPLE_CLIENT_IDS=com.countryflags.local
GOOGLE_CLIENT_IDS=country-flags-local.apps.googleusercontent.com
# Allowlist for the (currently unbuilt) web client. Never "*". Empty by default in
# production, meaning no cross-origin browser access until a web client origin is added.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Admin console authentication (docs/adr/ADR-014-admin-console-architecture.md).
# The console signs in with its own Google OAuth client; unset falls back to
# GOOGLE_CLIENT_IDS so local development needs one configuration.
# ADMIN_GOOGLE_CLIENT_IDS=country-flags-admin-local.apps.googleusercontent.com
# Who may bootstrap admin access: full emails and/or whole domains ("@example.com").
# Empty by default — nobody can sign in until the deployment provides the list
# (from Secret Manager in hosted environments).
# ADMIN_EMAIL_ALLOWLIST=admin@example.com,@example.org
# Origins the deployed admin console is served from; admin mutations from any
# other origin are rejected (CSRF boundary on top of the SameSite cookie).
ADMIN_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_SESSION_IDLE_TTL_SECONDS=3600
ADMIN_SESSION_ABSOLUTE_TTL_SECONDS=43200
# Where the editorial catalog and its JSON Schema live, relative to the
# backend working directory. Defaults fit the monorepo; the Docker image
# bakes both files in and overrides the paths.
# ADMIN_CATALOG_PATH=../tools/content-pipeline/editorial/catalog.json
# ADMIN_EDITORIAL_SCHEMA_PATH=../contracts/schemas/content/editorial-catalog.v2.schema.json
# ADMIN_EDITORIAL_SCHEMA_V3_PATH=../contracts/schemas/content/editorial-catalog.v3.schema.json
# The console opens editorial pull requests and can start the existing
# publish workflow. Give it a GitHub App installation token or a fine-grained
# token scoped to this repository with contents:write and pull_requests:write,
# plus actions:write only if the console should dispatch the workflow itself.
# Unset means the console degrades to "download the export and open a pull
# request by hand" rather than failing.
# ADMIN_GITHUB_TOKEN=
# ADMIN_GITHUB_OWNER=dudeinhoodie
# ADMIN_GITHUB_REPOSITORY=country-flags
# ADMIN_GITHUB_BASE_BRANCH=master
# ADMIN_GITHUB_PUBLISH_WORKFLOW=publish-content-dev.yml
# Which Cloud Run Job carries out a release the console asks for (ADR-017).
# No credential belongs here: the revision starts the job with its own
# identity, and the signing key and the right to write content belong to the
# job's service account rather than to this process. All three or none —
# a partial configuration is a console that believes it can publish. Unset
# means runs are recorded and wait, and the release screen says so.
# PUBLISHER_JOB_PROJECT=speedy-web-235610
# PUBLISHER_JOB_REGION=europe-west3
# PUBLISHER_JOB_NAME=content-publisher-dev
# Upload limit for a single flag or coat of arms. The default is 2 MB: these
# files are small, and the limit exists to stop a pathological upload.
# ADMIN_ASSET_MAX_BYTES=2097152
# Draft uploads live in their own NON-PUBLIC bucket, never in a prefix of the
# published one: content is served from a bucket with uniform public read,
# where a "private prefix" is not private. Unset means an in-process store,
# which is what local runs and tests use.
# ADMIN_DRAFT_OBJECT_STORAGE_PROVIDER=s3
# ADMIN_DRAFT_OBJECT_STORAGE_BUCKET=country-flags-dev-drafts
# ADMIN_DRAFT_OBJECT_STORAGE_REGION=europe-west3
# ADMIN_DRAFT_OBJECT_STORAGE_ENDPOINT=https://storage.googleapis.com
# ADMIN_DRAFT_OBJECT_STORAGE_FORCE_PATH_STYLE=true
# ADMIN_DRAFT_OBJECT_STORAGE_PUBLIC_BASE_URL=https://invalid.local/no-public-access
# Paid decks and Apple In-App Purchase (docs/17-paid-decks-storekit.md §8, §14).
# The store a deployment believes is decided by DEPLOYMENT_ENV and cannot be
# talked out of it: prod verifies only Production transactions, dev only
# Sandbox, and local/CI default to LOCAL_TEST, where StoreKit's own test
# configuration signs nothing and verification is skipped. A local run may be
# pointed at SANDBOX by hand; nothing outside prod may be pointed at PRODUCTION.
# COMMERCE_APPLE_STORE_ENVIRONMENT=LOCAL_TEST
# The release image never runs the local test verifier whatever it is pointed
# at: with NODE_ENV=production a LOCAL_TEST store simply verifies nothing.
# The app record a transaction must have been signed for. Leave the bundle id
# empty and the deployment simply cannot accept purchases yet — the endpoints
# answer a stable STORE_NOT_CONFIGURED rather than the process refusing to
# start, which is what lets the schema and the API ship before App Store
# Connect has an app record. The app Apple ID is required for PRODUCTION.
# COMMERCE_APPLE_BUNDLE_ID=app.countryflags.mobile.dev
# COMMERCE_APPLE_APP_APPLE_ID=
# Apple's root certificates, base64-encoded DER, comma-separated. Required for
# SANDBOX and PRODUCTION; downloaded from Apple's PKI page, not from us.
# COMMERCE_APPLE_ROOT_CERTIFICATES=
# App Store Server API credential, used only by the reconciliation/store-sync
# job and never by transaction verification. The private key lives in Secret
# Manager and reaches the process as configuration; it is never committed and
# never logged. All three are set together or not at all.
# COMMERCE_APPLE_IAP_KEY_ID=
# COMMERCE_APPLE_IAP_ISSUER_ID=
# COMMERCE_APPLE_IAP_PRIVATE_KEY=
# Grace period between marking readiness as failing and closing the HTTP server on
# SIGTERM/SIGINT, so a load balancer has time to stop routing before the process exits.
SHUTDOWN_DRAIN_MS=5000
# Content bundle pipeline (CLI-only; the running API does not read these).
# OBJECT_STORAGE_PROVIDER=memory selects a network-free in-process store, useful for tests.
# Set to "s3" plus the vars below to target local MinIO (see infrastructure/compose.yaml) or
# a production S3-compatible bucket.
OBJECT_STORAGE_PROVIDER=memory
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# The public root of the bucket, without a trailing slash. A publish stores a release
# under content/<contentVersion>/<path> and hands clients that key behind this address,
# so it is what every asset URL of a release published here is built on. In production
# it is the CDN in front of the bucket, which keeps those URLs what they have always been.
# OBJECT_STORAGE_PUBLIC_BASE_URL=
# Generated bundles ship UNSIGNED (signature keyId "unsigned-candidate"). Before publishing,
# sign the bundle locally: `yarn content:bundle:sign -- --bundle-dir <dir>`; validate/publish
# then verify the signature. Do not commit a signed manifest — `content build` owns the
# generated output and will revert it.
# CONTENT_SIGNING_KEY_ID and CONTENT_SIGNING_PRIVATE_KEY (base64 PKCS8 PEM) are required by
# `content:bundle:sign`. CONTENT_SIGNING_PUBLIC_KEYS (base64 JSON map of keyId -> PEM SPKI
# public key) is required by `content:bundle:validate`/`publish` to verify a signed bundle.
# CONTENT_SIGNING_KEY_ID=
# CONTENT_SIGNING_PRIVATE_KEY=
# CONTENT_SIGNING_PUBLIC_KEYS=
# OpenTelemetry traces/metrics are read directly from process.env before the Nest app
# bootstraps (so they can be set before anything under instrumentation loads), not through
# the validated EnvironmentVariables. @opentelemetry/api's own tracer/meter are already
# no-ops when OTEL_ENABLED is unset, which is the required "NoOp by default" behavior.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SERVICE_NAME=country-flags-api
# Identifies the deployed release in logs, traces and metrics. Hosted dev/prod
# must set the release image tag / git SHA; the "dev" placeholder is rejected there.
SERVICE_RELEASE=dev
