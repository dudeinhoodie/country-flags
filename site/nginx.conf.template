# Substituted by the stock nginx entrypoint. Only ${PORT},
# ${SITE_DOCUMENTS_UPSTREAM} and ${SITE_ROBOTS_TAG} are environment
# variables; $uri, $proxy_host and friends are nginx runtime variables and
# survive envsubst untouched.
server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  # `all` in production, `noindex, nofollow` everywhere else: the dev stand
  # serves the same documents under another address, and a search engine
  # must never offer that address as the policy.
  add_header X-Robots-Tag "${SITE_ROBOTS_TAG}" always;

  location = /healthz {
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  # The runtime config must never be cached: it is what tells the page
  # which deployment it is.
  location = /config.json {
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Robots-Tag "${SITE_ROBOTS_TAG}" always;
  }

  # The published documents, read from the environment's bucket rather than
  # from the API: the console publishes a snapshot there, and the page reads
  # the snapshot, so a policy answers whether or not the backend is up.
  # SITE_DOCUMENTS_UPSTREAM is the origin plus prefix without a trailing
  # slash; the /documents/ prefix is replaced, so /documents/index.json
  # reaches the bucket as <upstream>/index.json. The upstream's own
  # Cache-Control (set on each object at publish) passes through.
  location /documents/ {
    proxy_pass ${SITE_DOCUMENTS_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header Connection "";
    proxy_hide_header x-goog-generation;
    proxy_hide_header x-goog-metageneration;
    proxy_hide_header x-goog-hash;
    proxy_hide_header x-goog-storage-class;
    proxy_hide_header x-goog-stored-content-encoding;
    proxy_hide_header x-goog-stored-content-length;
    proxy_hide_header x-goog-meta-sha256;
    proxy_hide_header x-guploader-uploadid;
    proxy_hide_header alt-svc;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "${SITE_ROBOTS_TAG}" always;
  }

  # Vite emits content-hashed filenames under /assets, safe to cache forever.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "${SITE_ROBOTS_TAG}" always;
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Robots-Tag "${SITE_ROBOTS_TAG}" always;
    try_files $uri /index.html;
  }
}
