{
  "name": "country-flags",
  "private": true,
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "backend",
    "contracts",
    "tools/*"
  ],
  "resolutions": {
    "multer": "2.2.0",
    "path-to-regexp": "8.4.2",
    "lodash": "4.18.1",
    "fast-uri": "3.1.5"
  },
  "scripts": {
    "build": "yarn workspace @country-flags/backend build && yarn workspace @country-flags/content-pipeline build",
    "dev": "yarn workspace @country-flags/backend start:dev",
    "start": "yarn workspace @country-flags/backend start",
    "format": "yarn workspace @country-flags/backend format && yarn workspace @country-flags/contracts format && yarn workspace @country-flags/content-pipeline format",
    "format:check": "yarn workspace @country-flags/backend format:check && yarn workspace @country-flags/contracts format:check && yarn workspace @country-flags/content-pipeline format:check",
    "lint": "yarn workspace @country-flags/backend lint && yarn workspace @country-flags/content-pipeline lint",
    "typecheck": "yarn workspace @country-flags/backend typecheck && yarn workspace @country-flags/content-pipeline typecheck",
    "test": "yarn workspace @country-flags/backend test && yarn workspace @country-flags/content-pipeline test",
    "test:ci": "yarn workspace @country-flags/backend test:ci && yarn workspace @country-flags/content-pipeline test",
    "content": "yarn workspace @country-flags/content-pipeline content",
    "content:import:test": "yarn workspace @country-flags/backend content:import:test",
    "content:bundle:validate": "yarn workspace @country-flags/backend content:bundle:validate",
    "content:bundle:preview": "yarn workspace @country-flags/backend content:bundle:preview",
    "content:bundle:publish": "yarn workspace @country-flags/backend content:bundle:publish",
    "content:bundle:rollback": "yarn workspace @country-flags/backend content:bundle:rollback",
    "content:bundle:sign": "yarn workspace @country-flags/backend content:bundle:sign",
    "study:seed:test": "yarn workspace @country-flags/backend study:seed:test",
    "study:token:test": "yarn workspace @country-flags/backend study:token:test",
    "auth:provider-token:test": "yarn workspace @country-flags/backend auth:provider-token:test",
    "contracts:lint": "yarn workspace @country-flags/contracts lint",
    "contracts:bundle": "yarn workspace @country-flags/contracts bundle",
    "contracts:schemas": "yarn workspace @country-flags/contracts schemas",
    "contracts:compat": "yarn workspace @country-flags/contracts compatibility",
    "contracts:check": "yarn workspace @country-flags/contracts check",
    "prisma:generate": "yarn workspace @country-flags/backend prisma:generate",
    "prisma:migrate:deploy": "yarn workspace @country-flags/backend prisma:migrate:deploy",
    "prisma:validate": "yarn workspace @country-flags/backend prisma:validate",
    "docker:build": "docker build --file backend/Dockerfile --tag country-flags-backend:local .",
    "db:up": "docker compose -f infrastructure/compose.yaml up -d",
    "db:down": "docker compose -f infrastructure/compose.yaml down",
    "app:up": "docker compose -f infrastructure/compose.yaml --profile app up --build -d",
    "app:down": "docker compose -f infrastructure/compose.yaml --profile app down"
  }
}
