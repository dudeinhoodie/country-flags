{
  "$schema": "../schemas/configuration/feature-flag-registry.v1.schema.json",
  "schemaVersion": 1,
  "flags": [
    {
      "key": "study.multiple_choice.enabled",
      "type": "boolean",
      "defaultValue": false,
      "category": "release",
      "activationPolicy": "nextSession",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "learning",
      "description": "Enables objective multiple-choice study sessions",
      "reviewAfter": "2026-12-31"
    },
    {
      "key": "study.review_submission.enabled",
      "type": "boolean",
      "defaultValue": true,
      "category": "operational",
      "activationPolicy": "immediate",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "learning",
      "description": "Kill switch for review submission",
      "reviewAfter": "2027-07-01"
    },
    {
      "key": "home.recommended_decks.variant",
      "type": "string",
      "defaultValue": "control",
      "allowedValues": ["control", "personalized"],
      "category": "experiment",
      "activationPolicy": "nextLaunch",
      "serverEnforced": false,
      "clientVisible": true,
      "owner": "discovery",
      "description": "Chooses the recommended deck presentation",
      "reviewAfter": "2026-12-31"
    },
    {
      "key": "study.max_new_cards_per_session",
      "type": "number",
      "defaultValue": 10,
      "minimum": 0,
      "maximum": 20,
      "category": "remote_configuration",
      "activationPolicy": "nextSession",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "learning",
      "description": "Limits new cards selected for one study session",
      "reviewAfter": "2027-07-01"
    },
    {
      "key": "ads.enabled",
      "type": "boolean",
      "defaultValue": false,
      "category": "operational",
      "activationPolicy": "immediate",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "monetization",
      "description": "Global advertising kill switch",
      "reviewAfter": "2027-07-01"
    },
    {
      "key": "ads.home.bottom_banner.enabled",
      "type": "boolean",
      "defaultValue": false,
      "category": "release",
      "activationPolicy": "immediate",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "monetization",
      "description": "Enables the optional home banner placement",
      "reviewAfter": "2027-07-01"
    },
    {
      "key": "ads.catalog.inline_native.enabled",
      "type": "boolean",
      "defaultValue": false,
      "category": "release",
      "activationPolicy": "immediate",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "monetization",
      "description": "Enables the optional catalog native placement",
      "reviewAfter": "2027-07-01"
    },
    {
      "key": "ads.session_result.interstitial.enabled",
      "type": "boolean",
      "defaultValue": false,
      "category": "release",
      "activationPolicy": "immediate",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "monetization",
      "description": "Enables the optional post-session interstitial placement",
      "reviewAfter": "2027-07-01"
    },
    {
      "key": "ads.rewarded.optional_bonus.enabled",
      "type": "boolean",
      "defaultValue": false,
      "category": "release",
      "activationPolicy": "immediate",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "monetization",
      "description": "Reserves the rewarded placement as disabled",
      "reviewAfter": "2027-07-01"
    },
    {
      "key": "monetization.paid_decks.storefront_enabled",
      "type": "boolean",
      "defaultValue": false,
      "category": "release",
      "activationPolicy": "immediate",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "monetization",
      "description": "Rollout switch for the paid-decks storefront and its buy button",
      "reviewAfter": "2027-07-01"
    },
    {
      "key": "commerce.apple_iap.enabled",
      "type": "boolean",
      "defaultValue": false,
      "category": "release",
      "activationPolicy": "immediate",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "monetization",
      "description": "Shows the Apple in-app purchase button on paid decks",
      "reviewAfter": "2027-07-01"
    },
    {
      "key": "commerce.paid_decks.discovery.enabled",
      "type": "boolean",
      "defaultValue": false,
      "category": "release",
      "activationPolicy": "immediate",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "monetization",
      "description": "Shows paid decks in the catalog",
      "reviewAfter": "2027-07-01"
    },
    {
      "key": "commerce.deck.europe_coats.enabled",
      "type": "boolean",
      "defaultValue": false,
      "category": "release",
      "activationPolicy": "immediate",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "monetization",
      "description": "Shows the European Coats paid deck in the catalog",
      "reviewAfter": "2027-07-01"
    },
    {
      "key": "commerce.deck.us_state_flags.enabled",
      "type": "boolean",
      "defaultValue": false,
      "category": "release",
      "activationPolicy": "immediate",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "monetization",
      "description": "Shows the U.S. State Flags paid deck in the catalog",
      "reviewAfter": "2027-07-01"
    },
    {
      "key": "content.coats_of_arms.enabled",
      "type": "boolean",
      "defaultValue": false,
      "category": "release",
      "activationPolicy": "nextSession",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "content",
      "description": "Enables the coat-of-arms content type and its study cards",
      "reviewAfter": "2027-07-01"
    },
    {
      "key": "content.subdivisions.enabled",
      "type": "boolean",
      "defaultValue": false,
      "category": "release",
      "activationPolicy": "nextSession",
      "serverEnforced": true,
      "clientVisible": true,
      "owner": "content",
      "description": "Enables the subdivision content type and its study cards",
      "reviewAfter": "2027-07-01"
    }
  ]
}
