{
  "$schema": "../schemas/analytics/event-registry.v1.schema.json",
  "schemaVersion": 1,
  "events": [
    {
      "name": "onboarding.completed",
      "schemaVersion": 1,
      "owner": "growth",
      "purpose": "Measure completion of the initial product introduction",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "authState": {
          "type": "string",
          "required": true,
          "enumValues": ["guest", "authenticated"]
        }
      }
    },
    {
      "name": "deck.opened",
      "schemaVersion": 1,
      "owner": "discovery",
      "purpose": "Measure aggregate deck discovery",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "deckType": {
          "type": "string",
          "required": true,
          "enumValues": ["system", "dynamic", "custom"]
        }
      }
    },
    {
      "name": "study.session_started",
      "schemaVersion": 1,
      "owner": "learning",
      "purpose": "Measure study session starts by mode and requested size",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "mode": {
          "type": "string",
          "required": true,
          "enumValues": ["self_rated", "multiple_choice"]
        },
        "requestedCardCount": {
          "type": "integer",
          "required": true
        }
      }
    },
    {
      "name": "study.session_completed",
      "schemaVersion": 1,
      "owner": "learning",
      "purpose": "Measure aggregate session completion and difficulty",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "mode": {
          "type": "string",
          "required": true,
          "enumValues": ["self_rated", "multiple_choice"]
        },
        "deckType": {
          "type": "string",
          "required": true,
          "enumValues": ["system", "dynamic", "custom"]
        },
        "requestedCardCount": {
          "type": "integer",
          "required": true
        },
        "uniqueCardCount": {
          "type": "integer",
          "required": true
        },
        "reviewCount": {
          "type": "integer",
          "required": true
        },
        "durationBucket": {
          "type": "string",
          "required": true,
          "enumValues": ["under_60s", "60_180s", "over_180s"]
        },
        "correctRateBucket": {
          "type": "string",
          "required": true,
          "enumValues": ["0_49", "50_79", "80_89", "90_100"]
        }
      }
    },
    {
      "name": "study.session_abandoned",
      "schemaVersion": 1,
      "owner": "learning",
      "purpose": "Measure sessions abandoned before completion",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "mode": {
          "type": "string",
          "required": true,
          "enumValues": ["self_rated", "multiple_choice"]
        },
        "progressBucket": {
          "type": "string",
          "required": true,
          "enumValues": ["0_24", "25_49", "50_74", "75_99"]
        }
      }
    },
    {
      "name": "achievement.earned",
      "schemaVersion": 1,
      "owner": "learning",
      "purpose": "Measure aggregate achievement progression",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "category": {
          "type": "string",
          "required": true,
          "enumValues": ["mastery", "consistency", "objective"]
        },
        "tier": {
          "type": "string",
          "required": false,
          "enumValues": ["bronze", "silver", "gold", "platinum"]
        }
      }
    },
    {
      "name": "feature.exposed",
      "schemaVersion": 1,
      "owner": "platform",
      "purpose": "Record an experiment variant that was actually displayed",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "flagKey": {
          "type": "string",
          "required": true
        },
        "variant": {
          "type": "string",
          "required": true
        },
        "experimentId": {
          "type": "string",
          "required": true
        },
        "surface": {
          "type": "string",
          "required": true
        }
      }
    },
    {
      "name": "auth.completed",
      "schemaVersion": 1,
      "owner": "identity",
      "purpose": "Measure authentication outcome without provider identity",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "provider": {
          "type": "string",
          "required": true,
          "enumValues": ["apple", "google"]
        },
        "result": {
          "type": "string",
          "required": true,
          "enumValues": ["success", "cancelled", "failed"]
        }
      }
    },
    {
      "name": "sync.completed",
      "schemaVersion": 1,
      "owner": "sync",
      "purpose": "Measure aggregate synchronization health",
      "category": "operational",
      "consentCategory": "essential_operations",
      "retentionClass": "operational_short",
      "properties": {
        "result": {
          "type": "string",
          "required": true,
          "enumValues": ["success", "partial", "failed"]
        },
        "durationBucket": {
          "type": "string",
          "required": true,
          "enumValues": ["under_1s", "1_5s", "over_5s"]
        }
      }
    },
    {
      "name": "content.update_completed",
      "schemaVersion": 1,
      "owner": "content",
      "purpose": "Measure aggregate content update health",
      "category": "operational",
      "consentCategory": "essential_operations",
      "retentionClass": "operational_short",
      "properties": {
        "result": {
          "type": "string",
          "required": true,
          "enumValues": ["success", "failed"]
        }
      }
    },
    {
      "name": "paid_deck.impression",
      "schemaVersion": 1,
      "owner": "monetization",
      "purpose": "Measure how often a deck that is sold is seen in the catalogue",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "access": {
          "type": "string",
          "required": true,
          "enumValues": ["locked", "owned"]
        }
      }
    },
    {
      "name": "paid_deck.opened",
      "schemaVersion": 1,
      "owner": "monetization",
      "purpose": "Measure how often a deck that is sold is opened from the catalogue",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "access": {
          "type": "string",
          "required": true,
          "enumValues": ["locked", "owned"]
        }
      }
    },
    {
      "name": "paywall.viewed",
      "schemaVersion": 1,
      "owner": "monetization",
      "purpose": "Measure how often the locked deck screen is shown and whether it could quote a price",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "offerState": {
          "type": "string",
          "required": true,
          "enumValues": ["loading", "priced", "unavailable"]
        },
        "isPurchaseOffered": {
          "type": "boolean",
          "required": true
        }
      }
    },
    {
      "name": "purchase.started",
      "schemaVersion": 1,
      "owner": "monetization",
      "purpose": "Measure purchase attempts, as the first step of the purchase funnel",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {}
    },
    {
      "name": "purchase.completed",
      "schemaVersion": 1,
      "owner": "monetization",
      "purpose": "Measure purchases that unlocked a deck, and whether the backend had acknowledged them yet",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "delivery": {
          "type": "string",
          "required": true,
          "enumValues": ["acknowledged", "queued"]
        }
      }
    },
    {
      "name": "purchase.pending",
      "schemaVersion": 1,
      "owner": "monetization",
      "purpose": "Measure purchases left waiting for approval, such as Ask to Buy",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {}
    },
    {
      "name": "purchase.cancelled",
      "schemaVersion": 1,
      "owner": "monetization",
      "purpose": "Measure purchases the customer chose not to complete",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {}
    },
    {
      "name": "purchase.failed",
      "schemaVersion": 1,
      "owner": "monetization",
      "purpose": "Measure purchase failures by a bounded reason, so a broken storefront is visible",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "reason": {
          "type": "string",
          "required": true,
          "enumValues": [
            "account_required",
            "could_not_verify",
            "product_unavailable",
            "purchases_not_allowed",
            "network",
            "store",
            "backend_unreachable"
          ]
        }
      }
    },
    {
      "name": "purchase.restore_completed",
      "schemaVersion": 1,
      "owner": "monetization",
      "purpose": "Measure how restores end, including the neutral case that found nothing",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "result": {
          "type": "string",
          "required": true,
          "enumValues": ["restored", "nothing_found", "failed"]
        }
      }
    },
    {
      "name": "paid_deck.content_loaded",
      "schemaVersion": 1,
      "owner": "monetization",
      "purpose": "Measure whether the cards of a newly opened deck reached the device",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "result": {
          "type": "string",
          "required": true,
          "enumValues": ["success", "failed"]
        }
      }
    },
    {
      "name": "paid_deck.study_started",
      "schemaVersion": 1,
      "owner": "monetization",
      "purpose": "Measure study sessions started in a deck that was bought",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "mode": {
          "type": "string",
          "required": true,
          "enumValues": ["self_rated", "multiple_choice"]
        }
      }
    },
    {
      "name": "card.detail_opened",
      "schemaVersion": 1,
      "owner": "content",
      "purpose": "Measure which kind of symbol learners look at in detail",
      "category": "product",
      "consentCategory": "product_analytics",
      "retentionClass": "product_standard",
      "properties": {
        "contentKind": {
          "type": "string",
          "required": true,
          "enumValues": ["flag", "coat_of_arms", "map", "other", "unknown"]
        }
      }
    }
  ]
}
