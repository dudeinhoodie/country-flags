{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://country-flags.app/contracts/content/v3/editorial-catalog.schema.json",
  "title": "Editorial catalog document",
  "description": "The editorial layer of the content catalog: decks, localized names, membership, relations and per-entity overrides. v3 stops assuming one flag per entity (ADR-020): an administrative subdivision is an entity with a parent, a symbol is a typed asset, and a deck holds card variants rather than bare entity keys. A v2 document is lifted to this shape on read, so both versions stay readable while the console learns to write v3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defaultLocale",
    "supportedLocales",
    "entities",
    "sourceAliases",
    "additionalRelations",
    "decks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "defaultLocale": {
      "$ref": "#/$defs/locale"
    },
    "supportedLocales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/locale"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "sourceAliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalRelations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "decks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/deck"
      }
    },
    "assetOverrides": {
      "type": "array",
      "description": "Editorially supplied drawings that outrank every adapter candidate. The file lives at editorial/overrides/assets/<entityKey>/<assetType>/<variant>.svg, or .png for a drawing that never had a vector. The type and variant are part of the path because one entity now has several symbols: a flat name per entity would make a coat of arms and a flag fight over one file.",
      "items": {
        "$ref": "#/$defs/assetOverride"
      }
    }
  },
  "$defs": {
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "entityKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "assetType": {
      "description": "What the drawing depicts. A country has at most one active drawing per type and variant, and the types never overwrite one another.",
      "enum": ["flag", "coat_of_arms", "map"]
    },
    "assetVariant": {
      "description": "Which drawing of this type: `current` is the one in force, and a historical or ceremonial variant carries its own key and its own validity.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
      "maxLength": 60
    },
    "templateCode": {
      "description": "The card template a member is taught through. FLAG_TO_COUNTRY shows the flag and asks for the entity; COAT_OF_ARMS_TO_COUNTRY shows the coat. The same entity under two templates is two cards with two schedules.",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "maxLength": 100
    },
    "templateSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "entitlementKey": {
      "description": "The stable right that opens a paid deck (ADR-019). It never changes once published and it is not a store product id: an Apple offer grants this key, and so may a later Google or Web purchase.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$",
      "maxLength": 120
    },
    "assetLocalization": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "What this particular drawing is called and what it means. It belongs to the asset rather than to the entity, because the story of the German federal eagle is the story of one symbol, not of Germany.",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "cardRef": {
      "description": "One card variant: an entity taught through a named template. Written as a bare entity key it takes the deck's default template, which is why a deck that lists bare keys must declare one.",
      "oneOf": [
        {
          "$ref": "#/$defs/entityKey"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["entityKey", "templateCode", "templateSchemaVersion"],
          "properties": {
            "entityKey": {
              "$ref": "#/$defs/entityKey"
            },
            "templateCode": {
              "$ref": "#/$defs/templateCode"
            },
            "templateSchemaVersion": {
              "$ref": "#/$defs/templateSchemaVersion"
            }
          }
        }
      ]
    },
    "localizedNames": {
      "description": "Locale to the value in that locale. A fact a curator writes is written once per locale, because a card back reads it in the reader's own.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "entityFacts": {
      "description": "Facts a curator states outright, in the shape the release publishes them. Written here rather than as override paths so that what is saved is what is published: a value the build does not read is worse than a value nobody entered.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "capitals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["names"],
            "properties": {
              "names": { "$ref": "#/$defs/localizedNames" },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": { "type": "integer", "minimum": 0 },
            "year": { "type": "integer" }
          }
        },
        "statehoodDate": {
          "description": "When the unit joined the entity above it. A state's, not a country's.",
          "type": "object",
          "additionalProperties": false,
          "required": ["date"],
          "properties": {
            "date": { "$ref": "#/$defs/isoDate" }
          }
        },
        "motto": {
          "type": "object",
          "additionalProperties": false,
          "required": ["names"],
          "properties": {
            "names": { "$ref": "#/$defs/localizedNames" }
          }
        },
        "largestCity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["names"],
          "properties": {
            "names": { "$ref": "#/$defs/localizedNames" }
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "status", "config", "recognitionStatus"],
      "properties": {
        "key": {
          "$ref": "#/$defs/entityKey"
        },
        "type": {
          "enum": [
            "country",
            "territory",
            "area",
            "subdivision",
            "region",
            "subregion"
          ]
        },
        "status": {
          "enum": ["active", "historical", "retired", "hidden"]
        },
        "parentKey": {
          "description": "The country or territory this administrative unit belongs to. Authoring convenience only: the publisher normalizes it into the canonical CONTAINS relation under the ADMINISTRATIVE taxonomy (ADR-020).",
          "$ref": "#/$defs/entityKey"
        },
        "config": {
          "type": "object",
          "description": "Presentation toggles. They never decide whether the entity is learnable — an active country, territory or area keeps its card and facts and stays available to every deck regardless (ADR-015). A subdivision is the exception in the other direction: it is learnable only through a deck that names it, and never through the all-countries listing.",
          "additionalProperties": false,
          "required": ["includeInCountryCatalog"],
          "properties": {
            "includeInCountryCatalog": {
              "type": "boolean",
              "description": "Whether the entity appears in the all-countries deck (`all-current` membership). Nothing else reads it."
            },
            "factsNotApplicable": {
              "type": "array",
              "description": "Fact types this entity does not have, as a matter of what it is rather than of what the sources know. Antarctica has no capital, currency, official language or resident population, and saying so is different from failing to find them: a declared type is published as a gap with reason `not_applicable`, and an entity left with no facts at all is a build failure unless every one of them was declared here (#272).",
              "uniqueItems": true,
              "items": {
                "enum": ["capitals", "currencies", "languages", "population"]
              }
            }
          }
        },
        "recognitionStatus": {
          "type": "string",
          "minLength": 1
        },
        "recognitionAsOf": {
          "$ref": "#/$defs/isoDate"
        },
        "validFrom": {
          "$ref": "#/$defs/isoDate"
        },
        "validTo": {
          "$ref": "#/$defs/isoDate"
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "isoAlpha2": {
              "type": "string",
              "pattern": "^[A-Za-z]{2}$"
            },
            "isoAlpha3": {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$"
            },
            "m49": {
              "type": "string",
              "pattern": "^[0-9]{3}$"
            },
            "isoSubdivision": {
              "description": "ISO 3166-2, such as US-CA. It has its own field because it is not a country code: writing it into isoAlpha2 or isoAlpha3 would put a state where every reader expects a country.",
              "type": "string",
              "pattern": "^[A-Za-z]{2}-[A-Za-z0-9]{1,3}$"
            },
            "localCode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "fipsCode": {
              "description": "Only where the source publishes one; it is not derived.",
              "type": "string",
              "minLength": 1,
              "maxLength": 10
            },
            "wikidataId": {
              "type": "string",
              "minLength": 1
            },
            "editorialKey": {
              "type": "string",
              "minLength": 1
            },
            "customCode": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "facts": {
          "$ref": "#/$defs/entityFacts"
        },
        "overrides": {
          "type": "object",
          "minProperties": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "subdivision"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["parentKey"],
            "properties": {
              "parentKey": {
                "$ref": "#/$defs/entityKey"
              },
              "config": {
                "type": "object",
                "properties": {
                  "includeInCountryCatalog": {
                    "const": false
                  }
                }
              },
              "recognitionStatus": {
                "const": "not_applicable"
              }
            }
          },
          "else": {
            "not": {
              "required": ["parentKey"]
            }
          }
        }
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentKey",
        "childKey",
        "taxonomyKey",
        "relationType",
        "primary"
      ],
      "properties": {
        "parentKey": {
          "$ref": "#/$defs/entityKey"
        },
        "childKey": {
          "$ref": "#/$defs/entityKey"
        },
        "taxonomyKey": {
          "type": "string",
          "minLength": 1
        },
        "relationType": {
          "enum": ["contains", "associated_with"]
        },
        "primary": {
          "type": "boolean"
        }
      }
    },
    "deckName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "deckAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "description": "Who may open the deck. Absent means FREE. Monetization lives here and nowhere else: no entity, asset or template is paid, and the price is the store's business rather than the catalog's (ADR-019).",
      "properties": {
        "model": {
          "enum": ["FREE", "ENTITLEMENT"]
        },
        "requiredEntitlementKey": {
          "$ref": "#/$defs/entitlementKey"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "model": {
                "const": "ENTITLEMENT"
              }
            },
            "required": ["model"]
          },
          "then": {
            "required": ["requiredEntitlementKey"],
            "properties": {
              "requiredEntitlementKey": {
                "$ref": "#/$defs/entitlementKey"
              }
            }
          },
          "else": {
            "not": {
              "required": ["requiredEntitlementKey"]
            }
          }
        }
      ]
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "names", "members"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": ["curated", "taxonomy"]
        },
        "names": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/deckName"
          }
        },
        "defaultTemplateCode": {
          "$ref": "#/$defs/templateCode"
        },
        "defaultTemplateSchemaVersion": {
          "$ref": "#/$defs/templateSchemaVersion"
        },
        "members": {
          "oneOf": [
            {
              "const": "all-current"
            },
            {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cardRef"
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["taxonomy"],
              "properties": {
                "taxonomy": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "access": {
          "$ref": "#/$defs/deckAccess"
        },
        "previewCards": {
          "description": "The card variants a locked deck may show before it is bought — at most three, each of them a member. This is the editorial spelling of the admin contract's previewCardIds: the console names published learning cards, the catalog names the refs they resolve from. A preview is a separate published projection, never a hole in the cards endpoint.",
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/cardRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["members"],
            "properties": {
              "members": {
                "type": "array",
                "contains": {
                  "type": "string"
                }
              }
            }
          },
          "then": {
            "required": ["defaultTemplateCode", "defaultTemplateSchemaVersion"],
            "properties": {
              "defaultTemplateCode": {
                "$ref": "#/$defs/templateCode"
              },
              "defaultTemplateSchemaVersion": {
                "$ref": "#/$defs/templateSchemaVersion"
              }
            }
          }
        },
        {
          "if": {
            "required": ["members"],
            "properties": {
              "members": {
                "type": "object"
              }
            }
          },
          "then": {
            "required": ["defaultTemplateCode", "defaultTemplateSchemaVersion"],
            "properties": {
              "defaultTemplateCode": {
                "$ref": "#/$defs/templateCode"
              },
              "defaultTemplateSchemaVersion": {
                "$ref": "#/$defs/templateSchemaVersion"
              }
            }
          }
        }
      ]
    },
    "assetOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityKey",
        "assetType",
        "variant",
        "aspectRatio",
        "license",
        "sourceUrl",
        "reason"
      ],
      "properties": {
        "entityKey": {
          "$ref": "#/$defs/entityKey"
        },
        "assetType": {
          "$ref": "#/$defs/assetType"
        },
        "variant": {
          "$ref": "#/$defs/assetVariant"
        },
        "aspectRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "localizations": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/assetLocalization"
          }
        },
        "validFrom": {
          "$ref": "#/$defs/isoDate"
        },
        "validTo": {
          "$ref": "#/$defs/isoDate"
        }
      }
    }
  }
}
