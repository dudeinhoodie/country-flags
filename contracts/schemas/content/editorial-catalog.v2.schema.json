{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://country-flags.app/contracts/content/v2/editorial-catalog.schema.json",
  "title": "Editorial catalog document",
  "description": "The editorial layer of the content catalog: decks, localized names, membership, relations and per-entity overrides. This is the exact document tools/content-pipeline/editorial/catalog.json holds; an admin console draft must conform to it before it can be saved. v2 moves presentation toggles into the entity's config object (ADR-015).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defaultLocale",
    "supportedLocales",
    "entities",
    "sourceAliases",
    "additionalRelations",
    "decks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "defaultLocale": {
      "$ref": "#/$defs/locale"
    },
    "supportedLocales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/locale"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "sourceAliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalRelations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "decks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/deck"
      }
    },
    "assetOverrides": {
      "type": "array",
      "description": "Editorially supplied drawings that outrank every adapter candidate. The file itself lives at editorial/overrides/assets/<entityKey>.svg, or .png for a drawing that never had a vector; without this layer the next source refresh would silently overwrite a hand-picked flag.",
      "items": {
        "$ref": "#/$defs/assetOverride"
      }
    }
  },
  "$defs": {
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "entityKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "status", "config", "recognitionStatus"],
      "properties": {
        "key": {
          "$ref": "#/$defs/entityKey"
        },
        "type": {
          "enum": ["country", "territory", "area", "region", "subregion"]
        },
        "status": {
          "enum": ["active", "historical", "retired", "hidden"]
        },
        "config": {
          "type": "object",
          "description": "Presentation toggles. They never decide whether the entity is learnable — an active country, territory or area keeps its card and facts and stays available to every deck regardless (ADR-015).",
          "additionalProperties": false,
          "required": ["includeInCountryCatalog"],
          "properties": {
            "includeInCountryCatalog": {
              "type": "boolean",
              "description": "Whether the entity appears in the all-countries deck (`all-current` membership). Nothing else reads it."
            },
            "factsNotApplicable": {
              "type": "array",
              "description": "Fact types this entity does not have, as a matter of what it is rather than of what the sources know. Antarctica has no capital, currency, official language or resident population, and saying so is different from failing to find them: a declared type is published as a gap with reason `not_applicable`, and an entity left with no facts at all is a build failure unless every one of them was declared here (#272).",
              "uniqueItems": true,
              "items": {
                "enum": ["capitals", "currencies", "languages", "population"]
              }
            }
          }
        },
        "recognitionStatus": {
          "type": "string",
          "minLength": 1
        },
        "recognitionAsOf": {
          "$ref": "#/$defs/isoDate"
        },
        "validFrom": {
          "$ref": "#/$defs/isoDate"
        },
        "validTo": {
          "$ref": "#/$defs/isoDate"
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "isoAlpha2": {
              "type": "string",
              "pattern": "^[A-Za-z]{2}$"
            },
            "isoAlpha3": {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$"
            },
            "m49": {
              "type": "string",
              "pattern": "^[0-9]{3}$"
            },
            "wikidataId": {
              "type": "string",
              "minLength": 1
            },
            "editorialKey": {
              "type": "string",
              "minLength": 1
            },
            "customCode": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "overrides": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentKey",
        "childKey",
        "taxonomyKey",
        "relationType",
        "primary"
      ],
      "properties": {
        "parentKey": {
          "$ref": "#/$defs/entityKey"
        },
        "childKey": {
          "$ref": "#/$defs/entityKey"
        },
        "taxonomyKey": {
          "type": "string",
          "minLength": 1
        },
        "relationType": {
          "enum": ["contains", "associated_with"]
        },
        "primary": {
          "type": "boolean"
        }
      }
    },
    "deckName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "names", "members"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": ["curated", "taxonomy"]
        },
        "names": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/deckName"
          }
        },
        "members": {
          "oneOf": [
            {
              "const": "all-current"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/entityKey"
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["taxonomy"],
              "properties": {
                "taxonomy": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "assetOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityKey",
        "assetType",
        "aspectRatio",
        "license",
        "sourceUrl",
        "reason"
      ],
      "properties": {
        "entityKey": {
          "$ref": "#/$defs/entityKey"
        },
        "assetType": {
          "enum": ["flag"]
        },
        "aspectRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "validFrom": {
          "$ref": "#/$defs/isoDate"
        },
        "validTo": {
          "$ref": "#/$defs/isoDate"
        }
      }
    }
  }
}
