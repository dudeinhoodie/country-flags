{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://country-flags.app/contracts/configuration/v1/feature-flag-registry.schema.json",
  "title": "Feature flag registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "flags"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "flags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flag"
      }
    }
  },
  "$defs": {
    "baseFlagProperties": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){1,}$"
        },
        "category": {
          "enum": [
            "release",
            "operational",
            "experiment",
            "remote_configuration"
          ]
        },
        "activationPolicy": {
          "enum": ["immediate", "nextSession", "nextLaunch"]
        },
        "serverEnforced": {
          "type": "boolean"
        },
        "clientVisible": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reviewAfter": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "flag": {
      "oneOf": [
        {
          "$ref": "#/$defs/booleanFlag"
        },
        {
          "$ref": "#/$defs/stringFlag"
        },
        {
          "$ref": "#/$defs/numberFlag"
        }
      ]
    },
    "booleanFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "defaultValue",
        "category",
        "activationPolicy",
        "serverEnforced",
        "clientVisible",
        "owner",
        "description",
        "reviewAfter"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){1,}$"
        },
        "type": {
          "const": "boolean"
        },
        "defaultValue": {
          "type": "boolean"
        },
        "category": {
          "enum": ["release", "operational", "experiment"]
        },
        "activationPolicy": {
          "enum": ["immediate", "nextSession", "nextLaunch"]
        },
        "serverEnforced": {
          "type": "boolean"
        },
        "clientVisible": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reviewAfter": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "stringFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "defaultValue",
        "allowedValues",
        "category",
        "activationPolicy",
        "serverEnforced",
        "clientVisible",
        "owner",
        "description",
        "reviewAfter"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){1,}$"
        },
        "type": {
          "const": "string"
        },
        "defaultValue": {
          "type": "string",
          "maxLength": 256
        },
        "allowedValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "category": {
          "enum": [
            "release",
            "operational",
            "experiment",
            "remote_configuration"
          ]
        },
        "activationPolicy": {
          "enum": ["immediate", "nextSession", "nextLaunch"]
        },
        "serverEnforced": {
          "type": "boolean"
        },
        "clientVisible": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reviewAfter": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "numberFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "defaultValue",
        "minimum",
        "maximum",
        "category",
        "activationPolicy",
        "serverEnforced",
        "clientVisible",
        "owner",
        "description",
        "reviewAfter"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){1,}$"
        },
        "type": {
          "const": "number"
        },
        "defaultValue": {
          "type": "number"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "category": {
          "const": "remote_configuration"
        },
        "activationPolicy": {
          "enum": ["immediate", "nextSession", "nextLaunch"]
        },
        "serverEnforced": {
          "type": "boolean"
        },
        "clientVisible": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reviewAfter": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
