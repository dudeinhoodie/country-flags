{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://country-flags.app/contracts/configuration/v1/ad-placement-registry.schema.json",
  "title": "Advertising placement registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "placements"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "placements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/placement"
      }
    }
  },
  "$defs": {
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "format",
        "defaultEnabled",
        "approvedForRelease",
        "featureFlag",
        "activationPolicy",
        "allowedSurfaces",
        "owner",
        "description"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "format": {
          "enum": ["BANNER", "NATIVE", "INTERSTITIAL", "REWARDED"]
        },
        "defaultEnabled": {
          "const": false
        },
        "approvedForRelease": {
          "const": false
        },
        "featureFlag": {
          "type": "string",
          "pattern": "^ads\\.[a-z0-9_.]+\\.enabled$"
        },
        "activationPolicy": {
          "const": "immediate"
        },
        "allowedSurfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["HOME", "CATALOG", "SESSION_RESULT", "OPTIONAL_BONUS"]
          }
        },
        "owner": {
          "const": "monetization"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
