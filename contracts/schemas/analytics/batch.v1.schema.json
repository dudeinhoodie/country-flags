{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://country-flags.app/contracts/analytics/v1/batch.schema.json",
  "title": "Analytics event batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payloadVersion", "events"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "payloadVersion": {
      "const": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventName",
        "schemaVersion",
        "occurredAt",
        "anonymousId",
        "sessionId",
        "context",
        "properties"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "anonymousId": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "sessionId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "properties": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean"]
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "appVersion", "build", "locale"],
      "properties": {
        "platform": {
          "enum": ["ios", "android", "web"]
        },
        "appVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "featureConfigVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
