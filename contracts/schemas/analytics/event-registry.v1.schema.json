{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://country-flags.app/contracts/analytics/v1/event-registry.schema.json",
  "title": "Analytics event registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "events"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventDefinition"
      }
    }
  },
  "$defs": {
    "eventDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schemaVersion",
        "owner",
        "purpose",
        "category",
        "consentCategory",
        "retentionClass",
        "properties"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "category": {
          "enum": ["product", "operational"]
        },
        "consentCategory": {
          "enum": ["product_analytics", "essential_operations"]
        },
        "retentionClass": {
          "enum": ["product_standard", "operational_short"]
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/propertyDefinition"
          }
        }
      }
    },
    "propertyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": {
          "enum": ["string", "integer", "number", "boolean"]
        },
        "required": {
          "type": "boolean"
        },
        "enumValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
