{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://country-flags.app/content/v1/learning-cards.schema.json",
  "title": "Country Flags learning cards",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cards"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityKey",
        "templateCode",
        "templateSchemaVersion",
        "semanticVersion",
        "status",
        "revisions"
      ],
      "properties": {
        "entityKey": {
          "type": "string",
          "minLength": 1
        },
        "templateCode": {
          "type": "string",
          "minLength": 1
        },
        "templateSchemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "semanticVersion": {
          "type": "integer",
          "minimum": 1
        },
        "supersedesSemanticVersion": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "status": {
          "enum": ["active", "retired"]
        },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/revision"
          }
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "promptFingerprint",
        "changeClassification",
        "progressPolicy",
        "effectiveFrom"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "promptAssetKey": {
          "type": ["string", "null"]
        },
        "promptFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "changeClassification": {
          "enum": ["technical", "equivalent"]
        },
        "progressPolicy": {
          "enum": ["preserve"]
        },
        "effectiveFrom": {
          "type": "string",
          "format": "date-time"
        },
        "retiredAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}
