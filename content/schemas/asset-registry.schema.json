{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://country-flags.app/content/v1/asset-registry.schema.json",
  "title": "Country Flags asset registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "entityKey",
          "representations",
          "aspectRatio",
          "sourcePath",
          "license",
          "attribution",
          "provenance",
          "validFrom",
          "validTo"
        ],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "entityKey": { "type": "string", "minLength": 1 },
          "representations": {
            "description": "Every published encoding of this asset, in the order a client should prefer them: the vector original first when one exists, then raster by ascending scale. An editorial override may supply a drawing that never had a vector; it publishes a single raster original instead. This is the only place an encoding is described: the asset used to repeat the vector in its own path, mimeType and sha256 so a reader written before this field kept working, and those are gone.",
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                { "$ref": "#/$defs/vectorRepresentation" },
                { "$ref": "#/$defs/rasterRepresentation" },
                { "$ref": "#/$defs/rasterOriginalRepresentation" }
              ]
            }
          },
          "aspectRatio": { "type": "number", "exclusiveMinimum": 0 },
          "sourcePath": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "attribution": { "type": "string", "minLength": 1 },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceKey", "revision", "retrievedAt"],
            "properties": {
              "sourceKey": { "type": "string", "minLength": 1 },
              "revision": { "type": "string", "minLength": 1 },
              "retrievedAt": { "type": "string", "format": "date-time" }
            }
          },
          "validFrom": {
            "oneOf": [
              { "type": "string", "format": "date" },
              { "type": "null" }
            ]
          },
          "validTo": {
            "oneOf": [
              { "type": "string", "format": "date" },
              { "type": "null" }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "description": "Checksum of the bytes this representation serves. It belongs to the representation rather than to the asset because a client verifies what it actually downloaded, and a checksum of the vector cannot vouch for a raster.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "vectorRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mimeType", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^assets/svg/[^/]+\\.svg$" },
        "mimeType": { "const": "image/svg+xml" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "rasterRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mimeType", "sha256", "scale", "widthPx", "heightPx"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/png/[^/]+@[23]x\\.png$"
        },
        "mimeType": { "const": "image/png" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "scale": {
          "description": "Screen scale the raster was rendered for. There is no @1x because no device the app runs on has one.",
          "type": "integer",
          "enum": [2, 3]
        },
        "widthPx": { "type": "integer", "minimum": 1 },
        "heightPx": { "type": "integer", "minimum": 1 }
      }
    },
    "rasterOriginalRepresentation": {
      "description": "A raster that IS the original: an editorially supplied PNG with no vector behind it. It declares no screen scale — it was not rendered for one — and is published at the file's own pixel size, so it carries no @Nx suffix.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mimeType", "sha256", "widthPx", "heightPx"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/png/[^/]+\\.png$"
        },
        "mimeType": { "const": "image/png" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "widthPx": { "type": "integer", "minimum": 1 },
        "heightPx": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
