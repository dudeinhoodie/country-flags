{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://country-flags.app/content/v1/fact-collection.schema.json",
  "title": "Country Flags fact collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "factType", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "factType": {
      "enum": ["capitals", "currencies", "languages", "population"]
    },
    "records": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["entityKey", "gap", "reason"],
            "properties": {
              "entityKey": { "type": "string" },
              "gap": { "const": true },
              "reason": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["entityKey", "gap", "value", "provenance"],
            "properties": {
              "entityKey": { "type": "string" },
              "gap": { "const": false },
              "value": {},
              "provenance": { "$ref": "#/$defs/provenance" }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "factType": { "const": "capitals" } } },
      "then": {
        "properties": {
          "records": {
            "type": "array",
            "items": { "$ref": "#/$defs/capitalRecord" }
          }
        }
      }
    },
    {
      "if": { "properties": { "factType": { "const": "currencies" } } },
      "then": {
        "properties": {
          "records": {
            "type": "array",
            "items": { "$ref": "#/$defs/currencyRecord" }
          }
        }
      }
    },
    {
      "if": { "properties": { "factType": { "const": "languages" } } },
      "then": {
        "properties": {
          "records": {
            "type": "array",
            "items": { "$ref": "#/$defs/languageRecord" }
          }
        }
      }
    },
    {
      "if": { "properties": { "factType": { "const": "population" } } },
      "then": {
        "properties": {
          "records": {
            "type": "array",
            "items": { "$ref": "#/$defs/populationRecord" }
          }
        }
      }
    }
  ],
  "$defs": {
    "localizedNames": {
      "description": "A name per locale. The default locale can be absent from a source, but English is always there to fall back to.",
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKey", "revision", "retrievedAt"],
      "properties": {
        "sourceKey": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "retrievedAt": { "type": "string", "format": "date-time" }
      }
    },
    "period": {
      "type": "object",
      "properties": {
        "validFrom": { "type": "string", "format": "date" },
        "validTo": { "type": "string", "format": "date" }
      }
    },
    "gapRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityKey", "gap", "reason"],
      "properties": {
        "entityKey": { "type": "string" },
        "gap": { "const": true },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "capitalRecord": {
      "oneOf": [
        { "$ref": "#/$defs/gapRecord" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["entityKey", "gap", "value", "provenance"],
          "properties": {
            "entityKey": { "type": "string" },
            "gap": { "const": false },
            "value": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["names", "role"],
                "properties": {
                  "names": { "$ref": "#/$defs/localizedNames" },
                  "role": { "type": "string", "minLength": 1 },
                  "validFrom": { "type": "string", "format": "date" },
                  "validTo": { "type": "string", "format": "date" }
                }
              }
            },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        }
      ]
    },
    "currencyRecord": {
      "oneOf": [
        { "$ref": "#/$defs/gapRecord" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["entityKey", "gap", "value", "provenance"],
          "properties": {
            "entityKey": { "type": "string" },
            "gap": { "const": false },
            "value": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "role"],
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9]{2,7}$"
                  },
                  "role": { "type": "string", "minLength": 1 },
                  "names": { "$ref": "#/$defs/localizedNames" },
                  "validFrom": { "type": "string", "format": "date" },
                  "validTo": { "type": "string", "format": "date" }
                }
              }
            },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        }
      ]
    },
    "languageRecord": {
      "oneOf": [
        { "$ref": "#/$defs/gapRecord" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["entityKey", "gap", "value", "provenance"],
          "properties": {
            "entityKey": { "type": "string" },
            "gap": { "const": false },
            "value": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "role"],
                "properties": {
                  "code": { "type": "string", "minLength": 2 },
                  "role": { "type": "string", "minLength": 1 },
                  "names": { "$ref": "#/$defs/localizedNames" },
                  "validFrom": { "type": "string", "format": "date" },
                  "validTo": { "type": "string", "format": "date" }
                }
              }
            },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        }
      ]
    },
    "populationRecord": {
      "oneOf": [
        { "$ref": "#/$defs/gapRecord" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["entityKey", "gap", "value", "provenance"],
          "properties": {
            "entityKey": { "type": "string" },
            "gap": { "const": false },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "year"],
              "properties": {
                "value": { "type": "integer", "minimum": 0 },
                "year": { "type": "integer", "minimum": 1900 }
              }
            },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        }
      ]
    }
  }
}
