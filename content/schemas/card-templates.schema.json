{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://country-flags.app/content/v1/card-templates.schema.json",
  "title": "Country Flags card templates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "templates"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "schemaVersion",
        "promptType",
        "answerType",
        "gradingMode",
        "promptSpec",
        "answerSpec",
        "status"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "promptType": {
          "type": "string",
          "minLength": 1
        },
        "answerType": {
          "type": "string",
          "minLength": 1
        },
        "gradingMode": {
          "enum": ["self_rated", "multiple_choice", "text"]
        },
        "promptSpec": {
          "type": "object"
        },
        "answerSpec": {
          "type": "object"
        },
        "backSideFactTypes": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "enum": ["population", "capital", "area", "language", "currency", "other"]
          }
        },
        "status": {
          "enum": ["draft", "published", "retired"]
        }
      }
    }
  }
}
